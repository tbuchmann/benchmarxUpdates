<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.benchmarx</groupId>
    <artifactId>ecoretosql-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>BenchmarxEcoreToSQL</artifactId>
  <packaging>jar</packaging>
  <name>BenchmarX - Ecore to SQL Tests</name>

  <build>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.eclipse.xtext</groupId>
        <artifactId>xtend-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <testClassesDirectory>${project.build.outputDirectory}</testClassesDirectory>
        </configuration>
      </plugin>
    </plugins>

    <testResources>
      <testResource>
        <directory>resources</directory>
      </testResource>
      <testResource>
        <directory>.</directory>
        <includes>
          <include>*.xmi</include>
          <include>*.corr.xmi</include>
        </includes>
      </testResource>
    </testResources>
  </build>

  <dependencies>
    <!-- Reactor siblings -->
    <dependency>
      <groupId>org.benchmarx</groupId>
      <artifactId>Benchmarx</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.benchmarx</groupId>
      <artifactId>SQL</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- EMF -->
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
    </dependency>
    <!-- emf.compare: installed locally via install-local-deps.sh -->
    <dependency>
      <groupId>org.eclipse.emf.compare</groupId>
      <artifactId>org.eclipse.emf.compare</artifactId>
    </dependency>

    <!-- Xtend runtime -->
    <dependency>
      <groupId>org.eclipse.xtend</groupId>
      <artifactId>org.eclipse.xtend.lib</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>org.eclipse.xtext.xbase.lib</artifactId>
    </dependency>

    <!-- Logging -->
    <dependency>
      <groupId>log4j</groupId>
      <artifactId>log4j</artifactId>
    </dependency>

    <!-- JUnit 5 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
    </dependency>

    <!--
      Tool JARs from lib/ – installed into the local Maven repo once via
      install-local-deps.sh (run from the repository root).
    -->
    <dependency>
      <groupId>org.benchmarx.tools</groupId>
      <artifactId>bxtend-ecore2sql</artifactId>
      <version>1.0.0</version>
    </dependency>
    <!-- bxagent-ecore2sql 1.0.0 (old, dev.emtagent package) kept in lib for reference only — excluded from classpath -->
    <dependency>
      <groupId>org.benchmarx.tools</groupId>
      <artifactId>emt-agent</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <!--
      de-tbuchmann-bxagent-ecore2sql: built from bxagent-transformations/de.tbuchmann.bxagent.ecore2sql
      Contains de.tbuchmann.bxagent.ecore2sql.Ecore2SqlTransformation used by BXAgentEcoreToSQL.
      Supersedes the old org.benchmarx.tools:bxagent-ecore2sql.
    -->
    <dependency>
      <groupId>org.benchmarx.tools</groupId>
      <artifactId>de-tbuchmann-bxagent-ecore2sql</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <!--
      bx-runtime: dev.bxagent.correspondence.* (CorrespondenceModel, TransformationContext, etc.)
      used by BXAgentEcoreToSQL. Supersedes the old org.benchmarx.tools:emt-agent.
    -->
    <dependency>
      <groupId>org.benchmarx.tools</groupId>
      <artifactId>bx-runtime</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.benchmarx.tools</groupId>
      <artifactId>mediniQVT</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.benchmarx.tools</groupId>
      <artifactId>qvtemf</artifactId>
      <version>1.0.0</version>
    </dependency>
  </dependencies>

</project>
