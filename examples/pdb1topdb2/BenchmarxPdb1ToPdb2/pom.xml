<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.benchmarx</groupId>
    <artifactId>pdb1topdb2-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>BenchmarxPdb1ToPdb2</artifactId>
  <packaging>jar</packaging>
  <name>BenchmarX - PDB1 to PDB2 Tests</name>

  <build>
    <sourceDirectory>src</sourceDirectory>  <!-- tests live in src/, not src/test/java -->
    <!--
      The tool JARs in lib/ are on the compile/test classpath via system scope below.
      The resources/ directory (XMI files, etc.) is added as a test resource so
      the tests can load models at runtime.
    -->
    <testResources>
      <testResource>
        <directory>resources</directory>
      </testResource>
      <testResource>
        <directory>.</directory>
        <includes>
          <include>*.xmi</include>
          <include>*.corr.xmi</include>
        </includes>
      </testResource>
    </testResources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- version inherited from parent pluginManagement -->
        <configuration>
          <!-- Test classes are compiled to target/classes (src/ is the main source dir) -->
          <testClassesDirectory>${project.build.outputDirectory}</testClassesDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <!-- Own metamodel projects (reactor siblings) -->
    <dependency>
      <groupId>org.benchmarx</groupId>
      <artifactId>Benchmarx</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.benchmarx</groupId>
      <artifactId>PDB1</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.benchmarx</groupId>
      <artifactId>PDB2</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- EMF -->
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
    </dependency>
    <!-- emf.compare: installed locally via install-local-deps.sh -->
    <dependency>
      <groupId>org.eclipse.emf.compare</groupId>
      <artifactId>org.eclipse.emf.compare</artifactId>
    </dependency>

    <!-- Logging -->
    <dependency>
      <groupId>log4j</groupId>
      <artifactId>log4j</artifactId>
    </dependency>

    <!-- JUnit 5 (test scope; engine auto-detected by surefire 3.x) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
    </dependency>

    <!--
      Tool JARs from lib/ – installed into the local Maven repo once via
      install-local-deps.sh (run from the repository root).
      After that these are normal Maven dependencies.
    -->
    <dependency>
      <groupId>org.benchmarx.tools</groupId>
      <artifactId>bxtend-pdb12pdb2</artifactId>
      <version>1.0.0</version>
    </dependency>
    <!--
      de-tbuchmann-bxagent-pdb12pdb2: built from ~/work/git/forschung/bxagent-transformations/de.tbuchmann.bxagent.pdb12pdb2
      Contains de.tbuchmann.bxagent.pdb12pdb2.Pdb12Pdb2Transformation used by BXAgentPdb12Pdb2.
      Supersedes the old org.benchmarx.tools:bxagent-pdb12pdb2.
    -->
    <dependency>
      <groupId>de.tbuchmann.bxagent</groupId>
      <artifactId>de-tbuchmann-bxagent-pdb12pdb2</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.benchmarx.tools</groupId>
      <artifactId>bxlang-pdb12pdb2</artifactId>
      <version>1.0.0</version>
    </dependency>
    <!--
      bx-runtime: dev.bxagent.correspondence.* needed by BXAgentPdb12Pdb2.
      Supersedes the old org.benchmarx.tools:bx-runtime.
    -->
    <dependency>
      <groupId>dev.bxagent</groupId>
      <artifactId>bx-runtime</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.benchmarx.tools</groupId>
      <artifactId>mediniQVT</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.benchmarx.tools</groupId>
      <artifactId>qvtemf</artifactId>
      <version>1.0.0</version>
    </dependency>

    <!-- commons-io (optional at runtime, used in some implementations) -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.18.0</version>
      <optional>true</optional>
    </dependency>
  </dependencies>

</project>
