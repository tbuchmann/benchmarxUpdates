package org.benchmarx.dsl.generator.templates

import org.benchmarx.dsl.benchmarxDSL.ProblemDecl

class ParameterResolverTemplate {

	def paramResolverContent(ProblemDecl p) '''
		package org.benchmarx.examples.«p.name.toLowerCase».testsuite;

		import org.benchmarx.BXTool;
		import org.junit.jupiter.api.extension.ExtensionContext;
		import org.junit.jupiter.api.extension.ParameterContext;
		import org.junit.jupiter.api.extension.ParameterResolutionException;
		import org.junit.jupiter.api.extension.ParameterResolver;
		import org.junit.jupiter.params.ParameterizedTest;

		import java.lang.reflect.Constructor;
		import java.lang.reflect.Method;
		import java.util.ArrayList;
		import java.util.List;

		/**
		 * Resolves {@link BXTool} parameters for lifecycle methods (e.g. {@code @BeforeEach}).
		 * The tool index is parsed from the JUnit 5 parameterized test display name "[N] ...".
		 * Generated by BenchmarxDSLGenerator — DO NOT EDIT.
		 */
		@SuppressWarnings({"unchecked", "rawtypes"})
		public class «p.name»ParameterResolver implements ParameterResolver {

		    @Override
		    public boolean supportsParameter(ParameterContext paramCtx, ExtensionContext extCtx) {
		        if (paramCtx.getDeclaringExecutable() instanceof Constructor) return false;
		        if (paramCtx.getDeclaringExecutable() instanceof Method m
		                && m.isAnnotationPresent(ParameterizedTest.class)) return false;
		        return BXTool.class.isAssignableFrom(paramCtx.getParameter().getType());
		    }

		    @Override
		    public Object resolveParameter(ParameterContext paramCtx, ExtensionContext extCtx) {
		        List<BXTool> tools = new ArrayList<>(«p.name»TestCase.tools());
		        int idx = invocationIndex(extCtx);
		        return tools.stream()
		            .skip(idx)
		            .findFirst()
		            .orElseThrow(() -> new ParameterResolutionException(
		                "No tool at index " + idx));
		    }

		    private int invocationIndex(ExtensionContext ctx) {
		        String name = ctx.getDisplayName();
		        if (name.startsWith("[")) {
		            int end = name.indexOf(']');
		            if (end > 0) {
		                try { return Integer.parseInt(name.substring(1, end)) - 1; }
		                catch (NumberFormatException ignored) {}
		            }
		        }
		        return 0;
		    }
		}
	'''
}
