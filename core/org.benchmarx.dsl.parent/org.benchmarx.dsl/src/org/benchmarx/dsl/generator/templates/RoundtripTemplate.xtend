package org.benchmarx.dsl.generator.templates

import org.benchmarx.dsl.benchmarxDSL.AnyPostcondition
import org.benchmarx.dsl.benchmarxDSL.ExactPostcondition
import org.benchmarx.dsl.benchmarxDSL.PostconditionDecl
import org.benchmarx.dsl.benchmarxDSL.ProblemDecl
import org.benchmarx.dsl.benchmarxDSL.Roundtrip
import org.benchmarx.dsl.benchmarxDSL.SuiteDecl

class RoundtripTemplate {

	def roundtripContent(SuiteDecl suite, ProblemDecl p) '''
		package org.benchmarx.examples.«p.name.toLowerCase».testsuite.alignment_based.roundtrip;

		import org.benchmarx.BXTool;
		import org.benchmarx.examples.«p.name.toLowerCase».testsuite.«p.name»ParameterResolver;
		import org.benchmarx.examples.«p.name.toLowerCase».testsuite.«p.name»TestCase;
		import org.junit.jupiter.api.extension.ExtendWith;
		import org.junit.jupiter.params.ParameterizedTest;
		import org.junit.jupiter.params.provider.MethodSource;

		/**
		 * Roundtrip tests for the «p.name» transformation problem.
		 * Generated by BenchmarxDSLGenerator — DO NOT EDIT.
		 */
		@SuppressWarnings({"unchecked", "rawtypes"})
		@ExtendWith(«p.name»ParameterResolver.class)
		public class RoundtripTests extends «p.name»TestCase {

		    public static java.util.Collection<BXTool> tools() {
		        return «p.name»TestCase.tools();
		    }

		    «FOR test : suite.tests.filter[category instanceof Roundtrip]»
		    @ParameterizedTest
		    @MethodSource("tools")
		    public void «test.name»(BXTool tool) {
		        this.tool = tool;
		        this.initialise();
		        «IF !test.setup.empty»
		        «FOR step : test.setup»
		        tool.performAndPropagate«step.side.toFirstUpper»Edit(
		            «step.side»Edit(«FOR op : step.ops SEPARATOR ", "»«helperRef(step.side, p)»::«op»«ENDFOR»));
		        «ENDFOR»
		        «ENDIF»
		        «IF test.preSource !== null»
		        util.assertPrecondition("«test.preSource.name»", "«test.preTarget.name»");
		        «ENDIF»
		        «FOR edit : test.edits»
		        tool.performAndPropagate«edit.side.toFirstUpper»Edit(
		            «edit.side»Edit(«FOR op : edit.ops SEPARATOR ", "»«helperRef(edit.side, p)»::«op»«ENDFOR»));
		        «ENDFOR»
		        «postcondition(test.postcondition)»
		        this.terminate();
		    }

		    «ENDFOR»
		}
	'''

	def protected helperRef(String side, ProblemDecl p) {
		if (side == "source") "srcHelper" else "trgHelper"
	}

	def protected postcondition(PostconditionDecl pc) {
		switch pc {
			ExactPostcondition: '''util.assertPostcondition("«pc.srcState.name»", "«pc.trgState.name»");'''
			AnyPostcondition:   '''util.assertAnyPostcondition(java.util.Map.of(«FOR alt : pc.alternatives SEPARATOR ","»"«alt.srcState.name»", "«alt.trgState.name»"«ENDFOR»));'''
		}
	}
}
